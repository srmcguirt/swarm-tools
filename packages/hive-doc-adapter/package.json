{
  "name": "hive-doc-adapter",
  "version": "0.1.0",
  "description": "SourceAdapter implementation that reads hive (cells/memories) and git history and emits a normalized doc-service DocumentationCorpus.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/joelhooks/opencode-swarm-plugin"
  },
  "author": "Joel Hooks",
  "license": "MIT",
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target bun --external @libsql/client --external doc-service && bunx tsc",
    "test": "bun test src/",
    "typecheck": "bunx tsc --noEmit"
  },
  "dependencies": {
    "@libsql/client": "^0.15.15",
    "doc-service": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.19.3",
    "typescript": "^5.7.2",
    "bun-types": "^1.3.4"
  }
}
